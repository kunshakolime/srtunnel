            await q.edit_message_text(f"✅ User `{username}` deleted", parse_mode="Markdown", reply_markup=kb_users())
        else:
            await q.edit_message_text("❌ Failed", reply_markup=kb_users())
        context.user_data.clear()

    elif data == "shoot_server":
        leave_menu()
        tmux = shutil.which("tmux")
        if not tmux:
            await q.edit_message_text("❌ tmux not found", reply_markup=kb_menu()); return
        result   = subprocess.run([tmux, "ls"], capture_output=True, text=True)
        sessions = [l.split(":")[0].strip() for l in result.stdout.splitlines() if ":" in l]
        if not sessions:
            await q.edit_message_text("ℹ️ No tmux sessions running", reply_markup=kb_menu()); return
        keyboard = [[InlineKeyboardButton(f"🎯 {s}", callback_data=f"shootsvc_{s}")] for s in sessions]
        keyboard.append([InlineKeyboardButton("🔙 Menu", callback_data="back_to_menu")])
        await q.edit_message_text("*Running Services*\n\nSelect a service to restart:",
                                   parse_mode="Markdown", reply_markup=InlineKeyboardMarkup(keyboard))

    elif data.startswith("shootsvc_"):
        service = data[9:]
        preview = ""
        config_file = cfg["CONFIG_FILE"]
        if service == "zivpn" and os.path.exists(config_file):
            try:
                content = open(config_file).read()
                preview = f"\n\n*Config Preview:*\n```\n{content[:400]}\n```"
                if len(content) > 400: preview += "\n_... (truncated)_"
            except Exception:
                preview = "\n\n⚠️ Could not read config"
        await q.edit_message_text(f"*Restart: {service}*{preview}\n\nConfirm?", parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup([
                [InlineKeyboardButton("✅ Confirm", callback_data=f"shootconfirm_{service}")],
                [InlineKeyboardButton("🔙 Cancel",  callback_data="shoot_server")],
            ]))

    elif data.startswith("shootconfirm_"):
        service = data[13:]
        tmux    = shutil.which("tmux")
        if tmux:
            subprocess.run([tmux, "send-keys", "-t", service, "C-c"], check=False)
            status_text = menu_text(live="normal") + f"\n\n✅ `{service}` restarted"
            await update.callback_query.edit_message_text(status_text, reply_markup=kb_main(), parse_mode="Markdown")
            chat_id = update.callback_query.message.chat_id
            msg_id  = update.callback_query.message.message_id
            context.user_data.clear()
            context.user_data["menu_msg_id"] = msg_id

            async def fade_status():
                await asyncio.sleep(4)
                if context.user_data.get("menu_msg_id") != msg_id: return
                try:
                    await context.bot.edit_message_text(menu_text(live="normal"),
                        chat_id=chat_id, message_id=msg_id, parse_mode="Markdown", reply_markup=kb_main())
                except Exception: pass
                await show_menu(update, context)

            asyncio.create_task(fade_status())
        else:
            await update.callback_query.edit_message_text("❌ tmux not found", reply_markup=kb_menu())
            context.user_data.clear()

    # ── DNS ───────────────────────────────────────────────────────────────────

    elif data == "dns_menu":
        leave_menu()
        await q.edit_message_text(dns_page_text(), parse_mode="Markdown", reply_markup=kb_dns_main())

    elif data == "dns_list":
        if not dns.is_configured():
            await q.edit_message_text("⚠️ Cloudflare not configured", reply_markup=kb_dns())
            return
        try:
            records = dns.list_records()
        except RuntimeError as e:
            await q.edit_message_text(f"❌ CF API error: {e}", reply_markup=kb_dns())
            return
        if not records:
            await q.edit_message_text("ℹ️ No DNS records found", reply_markup=kb_dns())
            return
        chunk_size = 20
        chunks = [records[i:i+chunk_size] for i in range(0, len(records), chunk_size)]
        for idx, chunk in enumerate(chunks):
            lines = [f"*📋 DNS Records ({idx*chunk_size+1}–{idx*chunk_size+len(chunk)} of {len(records)})*\n"]
            for r in chunk:
                proxy = "🟠" if r.get("proxied") else "⚪"
                lines.append(f"{proxy} `{r['name']}` → `{r['content']}` *{r['type']}*")
            is_last = idx == len(chunks) - 1
            kb = kb_dns() if is_last else None
            if idx == 0:
                await q.edit_message_text("\n".join(lines), parse_mode="Markdown", reply_markup=kb)
            else:
                await q.message.reply_text("\n".join(lines), parse_mode="Markdown", reply_markup=kb)

    elif data == "dns_new":
        if not dns.is_configured():
            await q.edit_message_text("⚠️ Cloudflare not configured", reply_markup=kb_dns())
            return
        context.user_data["dns_step"] = "type"
        await q.edit_message_text("*➕ New DNS Record*\n\nSelect record type:",
            parse_mode="Markdown", reply_markup=kb_dns_types())

    elif data.startswith("dnstype_"):
        rtype = data[8:]
        cf_domain = cfg.get("CF_ROOT_DOMAIN") or cfg.get("DOMAIN", "")
        context.user_data.update(dns_rtype=rtype, dns_step="name", action="dns_name")
        await q.edit_message_text(
            f"*Type: {rtype}*\n\nEnter subdomain name:\n`sub` → `sub.{cf_domain}`\n\n/cancel to go back",
            parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("❌ Cancel", callback_data="dns_menu")]]))

    elif data.startswith("dnsproxy_"):
        proxied  = data == "dnsproxy_yes"
        rtype    = context.user_data.get("dns_rtype", "A")
        name     = context.user_data.get("dns_name", "")
        value    = context.user_data.get("dns_value", "")
        context.user_data.clear()

        await q.edit_message_text("⏳ Creating record…", parse_mode="Markdown")
        result = dns.create_record(rtype, name, value, proxied)
        if result.get("success"):
            rec   = result["result"]
            proxy_label = "🟠 Proxied" if proxied else "⚪ DNS only"
            rid   = rec["id"]
            msg   = (
                f"✅ *Record Created*\n\n"
                f"`{rec['name']}`\n"
                f"Type: `{rtype}` · {proxy_label}\n"
                f"Value: `{value}`"
            )
            kb = InlineKeyboardMarkup([
                [InlineKeyboardButton("🗑 Delete this record", callback_data=f"del_dns_{rid}")],
                [InlineKeyboardButton("🔙 DNS",               callback_data="dns_menu")],
            ])
        else:
            errors = result.get("errors", [])
            msg    = f"❌ Failed: {errors[0].get('message') if errors else 'Unknown error'}"
            kb     = kb_dns()
        await q.edit_message_text(msg, parse_mode="Markdown", reply_markup=kb)

    elif data.startswith("del_dns_"):
        record_id = data[8:]
        result = dns.delete_record(record_id)
        if result.get("success"):
            await q.edit_message_text("🗑 Record deleted.", reply_markup=kb_dns())
        else:
            await q.edit_message_text("❌ Could not delete record.", reply_markup=kb_dns())

    elif data == "dns_delete_pick":
        if not dns.is_configured():
            await q.edit_message_text("⚠️ Cloudflare not configured", reply_markup=kb_dns())
            return
        try:
            records = dns.list_records()
        except RuntimeError as e:
            await q.edit_message_text(f"❌ CF API error: {e}", reply_markup=kb_dns())
            return
        if not records:
            await q.edit_message_text("ℹ️ No records to delete", reply_markup=kb_dns())
            return

        context.user_data["dns_delete_records"] = records
        context.user_data["action"] = "dns_delete_pick"
        chunk_size = 20
        chunks = [records[i:i+chunk_size] for i in range(0, len(records), chunk_size)]
        for idx, chunk in enumerate(chunks):
            lines = [f"*🗑 Delete a Record ({idx*chunk_size+1}–{idx*chunk_size+len(chunk)} of {len(records)})*\n"]
            for i, r in enumerate(chunk, start=idx*chunk_size+1):
                proxy = "🟠" if r.get("proxied") else "⚪"
                lines.append(f"`{i}.` {proxy} `{r['name']}` → `{r['content']}` *{r['type']}*")
            is_last = idx == len(chunks) - 1
            if is_last:
                lines.append("\n_Reply with the record number to delete_")
            cancel_kb = InlineKeyboardMarkup([[InlineKeyboardButton("❌ Cancel", callback_data="dns_menu")]])
            if idx == 0:
                await q.edit_message_text("\n".join(lines), parse_mode="Markdown", reply_markup=cancel_kb if is_last else None)
            else:
                await q.message.reply_text("\n".join(lines), parse_mode="Markdown", reply_markup=cancel_kb if is_last else None)

    elif data == "add_user":
        leave_menu()
        context.user_data["action"] = "add_user"
        await q.edit_message_text(
            "*Add User*\n\nFormat:\n`username` `[days]` `[temp]` `[pwd:pass]` `[limit:N]`\n\nExamples:\n"
            "`alice`\n`alice 30`\n`alice 7 temp`\n`alice pwd:mypass`\n`alice limit:2`\n\n/cancel to go back",
            parse_mode="Markdown", reply_markup=kb_menu())


async def on_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not await check_admin(update): return

    if update.message.document:
        action = context.user_data.get("action")
        if action not in ("restore_db", "sync_db"):
            await update.message.reply_text("❌ Unexpected file", reply_markup=kb_menu()); return
        if not update.message.document.file_name.endswith(".db"):
            await update.message.reply_text("❌ Please send a .db file", reply_markup=kb_menu()); return
        tmp = "uploaded_users.db"
        await (await update.message.document.get_file()).download_to_drive(tmp)
        if action == "restore_db":
            import shutil as _sh
            _sh.copy(tmp, cfg["DB_FILE"])
            os.remove(tmp)
            core.init_db()
            core.sync()
            await update.message.reply_text("✅ Database Restored", reply_markup=kb_menu())
        else:
            ok = core.sync_db(tmp)
            os.remove(tmp)
            await update.message.reply_text("✅ Database Synced" if ok else "❌ Invalid database file", reply_markup=kb_menu())
        context.user_data.clear()
        return

    action = context.user_data.get("action")
    if not action and "user_list" in context.user_data:
        try:
            idx  = int(update.message.text.strip()) - 1
            user = core.get_user(context.user_data["user_list"][idx]["username"])
            if not user:
                await update.message.reply_text("❌ User not found", reply_markup=kb_users()); return
            await update.message.reply_text(fmt_user(user), parse_mode="Markdown",
                reply_markup=kb_user_actions(user["username"], user["temporary"], user["status"] == "Active"))
            return
        except (ValueError, IndexError): pass

    if not action:
        await update.message.reply_text("Use /start", reply_markup=kb_menu()); return

    text = update.message.text.strip()

    # ── DNS text input steps ───────────────────────────────────────────────────

    if action == "dns_delete_pick":
        try:
            idx = int(text) - 1
            records = context.user_data.get("dns_delete_records", [])
            if idx < 0 or idx >= len(records):
                await update.message.reply_text("❌ Invalid number", reply_markup=kb_dns())
                context.user_data.clear()
                return
            record = records[idx]
            result = dns.delete_record(record["id"])
            if result.get("success"):
                await update.message.reply_text(
                    f"🗑 Deleted `{record['name']}` ({record['type']})",
                    parse_mode="Markdown", reply_markup=kb_dns())
            else:
                await update.message.reply_text("❌ Could not delete record", reply_markup=kb_dns())
        except ValueError:
            await update.message.reply_text("❌ Send a number", reply_markup=kb_dns())
        context.user_data.clear()
        return

    if action == "dns_name":
        cf_domain = cfg.get("CF_ROOT_DOMAIN") or cfg.get("DOMAIN", "")
        name = text.lower().replace(f".{cf_domain}", "")
        context.user_data.update(dns_name=name, action="dns_value")
        rtype = context.user_data.get("dns_rtype", "A")
        hint = {
            "A":     "IPv4 address (e.g. `1.2.3.4`)",
            "AAAA":  "IPv6 address",
            "CNAME": "target hostname (e.g. `myapp.vercel.app`)",
            "TXT":   "text value",
            "MX":    "mail server hostname",
        }.get(rtype, "value")
        await update.message.reply_text(
            f"Subdomain: *{name}.{cf_domain}*\n\nEnter {hint}:\n\n/cancel to go back",
            parse_mode="Markdown")
        return

    if action == "dns_value":
        rtype = context.user_data.get("dns_rtype", "A")
        context.user_data.update(dns_value=text, action=None)
        if rtype in dns.NO_PROXY_TYPES:
            name    = context.user_data.get("dns_name", "")
            proxied = False
            result  = dns.create_record(rtype, name, text, proxied)
            if result.get("success"):
                rec = result["result"]
                rid = rec["id"]
                msg = (
                    f"✅ *Record Created*\n\n"
                    f"`{rec['name']}`\n"
                    f"Type: `{rtype}` · ⚪ DNS only\n"
                    f"Value: `{text}`"
                )
                kb = InlineKeyboardMarkup([
                    [InlineKeyboardButton("🗑 Delete this record", callback_data=f"del_dns_{rid}")],
                    [InlineKeyboardButton("🔙 DNS",               callback_data="dns_menu")],
                ])
            else:
                errors = result.get("errors", [])
                msg    = f"❌ Failed: {errors[0].get('message') if errors else 'Unknown error'}"
                kb     = kb_dns()
            context.user_data.clear()
            await update.message.reply_text(msg, parse_mode="Markdown", reply_markup=kb)
        else:
            await update.message.reply_text(
                "Proxy through Cloudflare?",
                reply_markup=InlineKeyboardMarkup([
                    [InlineKeyboardButton("🟠 Proxied (CDN)", callback_data="dnsproxy_yes"),
                     InlineKeyboardButton("⚪ DNS only",      callback_data="dnsproxy_no")],
                    [InlineKeyboardButton("❌ Cancel",         callback_data="dns_menu")],
                ]))
        return

    # ── existing text input steps ──────────────────────────────────────────────

    if action == "add_user":
        parts = text.split()
        username, days, temporary, password, max_logins = parts[0], None, False, None, None
        rest = []
        for p in parts[1:]:
            if p.startswith("pwd:"):    password = p[4:]
            elif p.startswith("limit:"):
                try:
                    max_logins = int(p[6:])
                    if max_logins <= 0: raise ValueError
                except ValueError:
                    await update.message.reply_text("❌ Invalid limit", reply_markup=kb_menu()); return
            else: rest.append(p)
        if rest:
            try: days = int(rest[0])
            except ValueError:
                if rest[0].lower() in ("temp", "temporary", "t"): temporary = True
                else:
                    await update.message.reply_text(
                        "❌ Invalid format\n\nExamples:\n`user` `user 30` `user pwd:pass` `user 7 temp` `user limit:2`",
                        parse_mode="Markdown", reply_markup=kb_menu()); return
        if len(rest) >= 2 and rest[1].lower() in ("temp", "temporary", "t"):
            temporary = True

        ok, pwd, expires, linux_ok, err = core.add_user(username, password, days, temporary, max_logins)
        if ok:
            exp_text = expires[:10] if expires else "Never"
            msg = f"✅ *{'Temp' if temporary else 'User'} Added*\n\n`{username}` • `{pwd}`\nExpires: {exp_text}"
            if max_logins: msg += f"\nMax Logins: {max_logins}"
            if not linux_ok: msg += "\n\n⚠️ Linux user creation failed"
            await update.message.reply_text(msg, parse_mode="Markdown", reply_markup=kb_menu())
        else:
            await update.message.reply_text(
                "❌ Password already in use" if err == "password_exists" else "❌ Username exists",
                reply_markup=kb_menu())
        context.user_data.clear()

    elif action == "set_maxlogins":
        try:
            username = context.user_data.get("maxlogins_username")
            if not username: raise ValueError("❌ Session expired")
            n = int(text)
            if n < 0: raise ValueError("❌ Invalid number")
            limit = None if n == 0 else n
            context.user_data.clear()
            if core.set_maxlogins(username, limit):
                user  = core.get_user(username)
                label = "♾️ Unlimited" if limit is None else f"🔒 {limit} max"
                if user:
                    await update.message.reply_text(
                        fmt_user(user) + f"\n\n✅ Max logins → {label}", parse_mode="Markdown",
                        reply_markup=kb_user_actions(username, user["temporary"], user["status"] == "Active"))
                else:
                    await update.message.reply_text("❌ User not found", reply_markup=kb_users())
            else:
                await update.message.reply_text("❌ Failed", reply_markup=kb_users())
        except (ValueError, TypeError) as e:
            await update.message.reply_text(str(e) if str(e).startswith("❌") else "❌ Send a number (0 to remove)", reply_markup=kb_users())
            context.user_data.clear()

    elif action == "change_password_custom":
        username = context.user_data.get("change_password_username")
        ok, old, err = core.change_password(username, text)
        if ok:
            await update.message.reply_text(f"✅ *Password Changed*\n\n`{username}`\n`{old}` → `{text}`",
                                             parse_mode="Markdown", reply_markup=kb_users())
        else:
            await update.message.reply_text(
                "❌ Password already in use" if err == "password_exists" else "❌ User not found",
                reply_markup=kb_users())
        context.user_data.clear()

    elif action in ("modify_expiry_set", "modify_expiry_extend"):
        try:
            username = context.user_data.get("modify_expiry_username")
            if not username: raise ValueError("❌ Session expired")
            days = parse_positive_int(text)
            ok, new_exp = core.modify_expiry(username, days, extend=(action == "modify_expiry_extend"))
            if ok:
                prefix = f"Extended +{days}d" if action == "modify_expiry_extend" else "Expiry Set"
                await update.message.reply_text(f"✅ *{prefix}*\n\n`{username}`\n{new_exp[:10]}",
                                                 parse_mode="Markdown", reply_markup=kb_users())
            else:
                await update.message.reply_text("❌ Failed", reply_markup=kb_users())
        except ValueError as e:
            await update.message.reply_text(str(e), reply_markup=kb_users())
        finally:
            context.user_data.clear()


async def on_error(update, context):
    logger.error(f"Update {update} caused error {context.error}")


# ── Main ──────────────────────────────────────────────────────────────────────

def main():
    if not TOKEN:
        print("❌ TOKEN not set"); return

    core.init_db()
    r = core.sync()
    logger.info(f"Started. {r['deleted_count']} expired users cleaned.")

    app = Application.builder().token(TOKEN).build()
    app.add_handler(CommandHandler("start",  cmd_start))
    app.add_handler(CommandHandler("cancel", cmd_cancel))
    app.add_handler(CallbackQueryHandler(on_button))
    app.add_handler(MessageHandler((filters.TEXT & ~filters.COMMAND) | filters.Document.ALL, on_message))
    app.add_error_handler(on_error)

    for k, v in [("Domain", DOMAIN), ("DNSTT", DNSTT), ("Key", KEY)]:
        if v: logger.info(f"{k}: {v}")

    app.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == "__main__":
    main()
