                            [("🗑 Remove",       "slst_remove")],
                            [("🔄 Refresh Bot",  "slst_refresh_bot")],
                            [("🔙 Menu",         "back_to_menu")]))

    elif data == "slst_add":
        context.user_data["action"] = "slst_add"
        await q.edit_message_text(
            "*➕ Add Server*\n\n"
            "Send: `id name url token`\n\n"
            "Example:\n`vps2 Germany http://1.2.3.4:51700 mytoken`\n\n/cancel to go back",
            parse_mode="Markdown", reply_markup=kb_srvlist())

    elif data == "slst_remove":
        raw_list = context.user_data.get("api_serverlist") or []
        if not raw_list:
            await q.edit_message_text("ℹ️ Serverlist is empty", reply_markup=kb_srvlist()); return
        context.user_data["action"] = "slst_remove"
        lines = ["*🗑 Remove Server*\n"]
        for i, s in enumerate(raw_list, 1):
            lines.append(f"`{i}.` *{s.get('name','?')}* — `{s.get('url','?')}`")
        lines.append("\n_Reply with the number to remove_")
        await q.edit_message_text("\n".join(lines), parse_mode="Markdown",
                                  reply_markup=kb([("❌ Cancel", "serverlist_menu")]))

    elif data == "slst_refresh_bot":
        servers = await fetch_serverlist(sess["primary_token"])
        sess["servers"] = servers
        ids = {s["id"] for s in servers}
        if sess.get("active_id") not in ids:
            sess["active_id"] = servers[0]["id"] if servers else None
        set_session(uid, sess)
        await q.edit_message_text(
            f"✅ Bot server list refreshed — {len(servers)} server(s)",
            reply_markup=kb([("🖧 Serverlist", "serverlist_menu"), ("🔙 Menu", "back_to_menu")]))

    # ══════════════════════════════════════════════════════════════════════════
    # TOKENS
    # ══════════════════════════════════════════════════════════════════════════
    elif data == "tokens_menu":
        leave_menu()
        prim   = primary_server(uid)
        tokens = await api_get(prim, "/api/tokens")
        context.user_data["token_list"] = tokens
        lines = ["*🔑 Active Tokens*\n"]
        for t in tokens:
            lines.append(f"• `{t.get('label','?')}` — `{(t.get('token') or '')[:16]}…`")
        if not tokens: lines.append("_(none)_")
        await q.edit_message_text("\n".join(lines), parse_mode="Markdown",
            reply_markup=kb([("🗑 Revoke", "tokens_revoke_pick")],
                            [("🔙 Menu",   "back_to_menu")]))

    elif data == "tokens_revoke_pick":
        tokens = context.user_data.get("token_list", [])
        if not tokens:
            await q.edit_message_text("ℹ️ No tokens", reply_markup=kb_menu()); return
        context.user_data["action"] = "tokens_revoke"
        lines = ["*🗑 Revoke Token*\n"]
        for i, t in enumerate(tokens, 1):
            lines.append(f"`{i}.` `{t.get('label','?')}`")
        lines.append("\n_Reply with the number to revoke_")
        await q.edit_message_text("\n".join(lines), parse_mode="Markdown",
                                  reply_markup=kb([("❌ Cancel", "tokens_menu")]))

    else:
        logger.warning("Unhandled callback: %s", data)


# ── Message handler ───────────────────────────────────────────────────────────

async def on_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    uid    = update.effective_user.id
    action = context.user_data.get("action")
    text   = (update.message.text or "").strip()

    # Session required for everything else
    sess = get_session(uid)
    if not sess:
        text = "👋 *Welcome!*\n\nUse `/login <token>` to authenticate."
        # Remove the "🔐 Login" button since it triggers the old multi-step flow 
        if update.callback_query:
            await update.callback_query.edit_message_text(text, parse_mode="Markdown")
        else:
            await update.message.reply_text(text, parse_mode="Markdown")
        return

    server = active_server(uid)
    if not server:
        await update.message.reply_text("No active server. Use /login."); return

    # ── File upload ───────────────────────────────────────────────────────────
    if update.message.document:
        if action not in ("restore_db", "merge_db"):
            await update.message.reply_text("❌ Unexpected file", reply_markup=kb_menu()); return
        if not update.message.document.file_name.endswith(".db"):
            await update.message.reply_text("❌ Send a .db file", reply_markup=kb_menu()); return
        tg_file = await update.message.document.get_file()
        buf = io.BytesIO()
        await tg_file.download_to_memory(buf); buf.seek(0)
        endpoint = "/api/restore-db" if action == "restore_db" else "/api/merge-db"
        try:
            form = aiohttp.FormData()
            form.add_field("file", buf, filename="users.db",
                           content_type="application/octet-stream")
            await api_post(server, endpoint, data=form)
            verb = "Restored" if action == "restore_db" else "Merged"
            await update.message.reply_text(f"✅ Database {verb}", reply_markup=kb_menu())
        except ApiError as e:
            await update.message.reply_text(f"❌ {e.detail}", reply_markup=kb_menu())
        context.user_data.clear(); return

    if not action:
        await update.message.reply_text("Use /start", reply_markup=kb_menu()); return

    try:
        await _handle_text(update, context, uid, server, sess, action, text)
    except ApiError as e:
        await update.message.reply_text(f"❌ API {e.status}:\n`{e.detail}`",
                                        parse_mode="Markdown", reply_markup=kb_menu())
        context.user_data.clear()


async def _handle_text(update, context, uid, server, sess, action, text):  # noqa: C901

    if action == "add_user":
        parts    = text.split()
        username = parts[0]
        days, temporary, password, max_logins = None, False, None, None
        rest = []
        for p in parts[1:]:
            if   p.startswith("pwd:"):   password = p[4:]
            elif p.startswith("limit:"):
                try:    max_logins = int(p[6:]); assert max_logins > 0
                except: await update.message.reply_text("❌ Invalid limit"); return
            else: rest.append(p)
        if rest:
            try: days = int(rest[0])
            except ValueError:
                if rest[0].lower() in ("temp","temporary","t"): temporary = True
                else: await update.message.reply_text("❌ Invalid format"); return
        if len(rest) >= 2 and rest[1].lower() in ("temp","temporary","t"):
            temporary = True
        payload = {"username": username, "temporary": temporary}
        if days:       payload["days"]       = days
        if password:   payload["password"]   = password
        if max_logins: payload["max_logins"] = max_logins
        r = await api_post(server, "/api/users", json=payload)
        msg = (f"✅ *{'Temp' if temporary else 'User'} Added*\n\n"
               f"`{r['username']}` • `{r['password']}`\n"
               f"Expires: {r.get('expires') or 'Never'}")
        if r.get("max_logins"): msg += f"\nMax Logins: {r['max_logins']}"
        if not r.get("linux_ok", True): msg += "\n\n⚠️ Linux user creation failed"
        await update.message.reply_text(msg, parse_mode="Markdown", reply_markup=kb_menu())
        context.user_data.clear()

    elif action == "set_maxlogins":
        un = context.user_data.pop("maxlogins_username", None)
        if not un:
            await update.message.reply_text("❌ Session expired"); context.user_data.clear(); return
        try:    n = int(text); assert n >= 0
        except: await update.message.reply_text("❌ Send a number (0 = unlimited)"); context.user_data.clear(); return
        limit = None if n == 0 else n
        await api_post(server, f"/api/users/{un}/maxlogins", json={"max_logins": limit})
        label = "♾️ Unlimited" if limit is None else f"🔒 {limit} max"
        await update.message.reply_text(f"✅ `{un}` → {label}",
                                        parse_mode="Markdown", reply_markup=kb_users())
        context.user_data.clear()

    elif action == "change_password_custom":
        un = context.user_data.pop("change_password_username", None)
        r  = await api_post(server, f"/api/users/{un}/password", json={"password": text})
        await update.message.reply_text(
            f"✅ *Password Changed*\n\n`{un}`\n`{r['old_password']}` → `{r['new_password']}`",
            parse_mode="Markdown", reply_markup=kb_users())
        context.user_data.clear()

    elif action in ("modify_expiry_set", "modify_expiry_extend"):
        un = context.user_data.pop("modify_expiry_username", None)
        if not un:
            await update.message.reply_text("❌ Session expired"); context.user_data.clear(); return
        try:    days = int(text); assert days > 0
        except: await update.message.reply_text("❌ Must be a positive number"); context.user_data.clear(); return
        extend = action == "modify_expiry_extend"
        r = await api_post(server, f"/api/users/{un}/expiry",
                           json={"days": days, "extend": extend})
        prefix = f"Extended +{days}d" if extend else "Expiry Set"
        await update.message.reply_text(
            f"✅ *{prefix}*\n\n`{un}`\n{(r.get('expires') or '')[:10]}",
            parse_mode="Markdown", reply_markup=kb_users())
        context.user_data.clear()

    elif action == "dns_name":
        context.user_data.update(dns_name=text.lower(), action="dns_value")
        rtype = context.user_data.get("dns_rtype", "A")
        hint  = {"A":"IPv4","AAAA":"IPv6","CNAME":"target hostname",
                 "TXT":"text value","MX":"mail server"}.get(rtype, "value")
        await update.message.reply_text(
            f"Subdomain: *{text.lower()}*\n\nEnter {hint}:\n\n/cancel to go back",
            parse_mode="Markdown")

    elif action == "dns_value":
        NO_PROXY = {"TXT","MX","NS","SRV","CAA"}
        rtype = context.user_data.get("dns_rtype", "A")
        name  = context.user_data.get("dns_name", "")
        context.user_data.update(dns_value=text, action=None)
        if rtype in NO_PROXY:
            r   = await api_post(server, "/api/dns",
                                 json={"type": rtype, "name": name, "value": text, "proxied": False})
            rid = r.get("id") if isinstance(r, dict) else None
            msg = f"✅ *DNS Created*\n\n`{r.get('name',name)}`\n`{rtype}` · ⚪\n`{text}`"
            rows = []
            if rid: rows.append([InlineKeyboardButton("🗑 Delete", callback_data=f"del_dns_{rid}")])
            rows.append([InlineKeyboardButton("🔙 DNS", callback_data="dns_menu")])
            await update.message.reply_text(msg, parse_mode="Markdown",
                                            reply_markup=InlineKeyboardMarkup(rows))
            context.user_data.clear()
        else:
            await update.message.reply_text(
                "Proxy through Cloudflare?",
                reply_markup=kb([("🟠 Proxied", "dnsproxy_yes"), ("⚪ DNS only", "dnsproxy_no")],
                                [("❌ Cancel",  "dns_menu")]))

    elif action == "dns_delete_pick":
        try:
            idx     = int(text) - 1
            records = context.user_data.get("dns_delete_records", [])
            if not (0 <= idx < len(records)):
                await update.message.reply_text("❌ Invalid number", reply_markup=kb_dns())
                context.user_data.clear(); return
            rec = records[idx]
            await api_delete(server, f"/api/dns/{rec['id']}")
            await update.message.reply_text(
                f"🗑 Deleted `{rec['name']}` ({rec['type']})",
                parse_mode="Markdown", reply_markup=kb_dns())
        except ValueError:
            await update.message.reply_text("❌ Send a number", reply_markup=kb_dns())
        context.user_data.clear()

    elif action == "file_write":
        fname = context.user_data.pop("file_editing", None)
        if not fname:
            await update.message.reply_text("❌ Session expired"); context.user_data.clear(); return
        await api_put(server, f"/api/files/{fname}", json=text)
        await update.message.reply_text(f"✅ *{fname}* saved",
                                        parse_mode="Markdown", reply_markup=kb_files())
        context.user_data.clear()

    elif action == "xray_adduser":
        tag   = context.user_data.pop("xray_tag", None)
        parts = text.split()
        un    = parts[0]
        uid_v = parts[1] if len(parts) > 1 else None
        flow  = parts[2] if len(parts) > 2 else ""
        payload = {"username": un, "flow": flow}
        if uid_v: payload["uid"] = uid_v
        r = await api_post(server, f"/api/xray/inbounds/{tag}/users", json=payload)
        await update.message.reply_text(
            f"✅ `{un}` added to `{tag}`\nUUID: `{r.get('id','?')}`",
            parse_mode="Markdown", reply_markup=kb_xray())
        context.user_data.clear()

    elif action == "xray_add_inbound":
        try:    inbound = _json.loads(text)
        except: await update.message.reply_text("❌ Invalid JSON"); context.user_data.clear(); return
        r = await api_post(server, "/api/xray/inbounds", json=inbound)
        await update.message.reply_text(f"✅ Inbound `{r.get('tag','?')}` added",
                                        parse_mode="Markdown", reply_markup=kb_xray())
        context.user_data.clear()

    elif action == "scope_edit":
        try:    obj = _json.loads(text)
        except: await update.message.reply_text("❌ Invalid JSON"); context.user_data.clear(); return
        await api_post(server, "/api/scope", json=obj)
        await update.message.reply_text("✅ Scope updated", reply_markup=kb_scope())
        context.user_data.clear()

    elif action == "slst_add":
        parts = text.split(maxsplit=3)
        if len(parts) < 3:
            await update.message.reply_text("❌ Format: `id name url [token]`",
                                            parse_mode="Markdown"); return
        sid, name, url = parts[0], parts[1], parts[2]
        tok  = parts[3] if len(parts) > 3 else None
        prim = primary_server(uid)
        existing = await api_get(prim, "/api/serverlist")
        existing.append({"id": sid, "name": name, "url": url, "token": tok})
        await api_post(prim, "/api/serverlist", json={"servers": existing})
        await update.message.reply_text(f"✅ *{name}* added to serverlist",
                                        parse_mode="Markdown", reply_markup=kb_srvlist())
        context.user_data.clear()

    elif action == "slst_remove":
        raw_list = context.user_data.get("api_serverlist", [])
        try:
            idx = int(text) - 1
            if not (0 <= idx < len(raw_list)):
                await update.message.reply_text("❌ Invalid number"); context.user_data.clear(); return
            removed = raw_list.pop(idx)
            prim    = primary_server(uid)
            await api_post(prim, "/api/serverlist", json={"servers": raw_list})
            await update.message.reply_text(
                f"🗑 Removed *{removed.get('name','?')}*",
                parse_mode="Markdown", reply_markup=kb_srvlist())
        except ValueError:
            await update.message.reply_text("❌ Send a number")
        context.user_data.clear()

    elif action == "tokens_revoke":
        tokens = context.user_data.get("token_list", [])
        try:
            idx = int(text) - 1
            if not (0 <= idx < len(tokens)):
                await update.message.reply_text("❌ Invalid number"); context.user_data.clear(); return
            tok  = tokens[idx]["token"]
            prim = primary_server(uid)
            await api_delete(prim, "/api/tokens", json={"token": tok})
            await update.message.reply_text(
                f"✅ Token `{tokens[idx].get('label','?')}` revoked",
                parse_mode="Markdown", reply_markup=kb_menu())
        except ValueError:
            await update.message.reply_text("❌ Send a number")
        context.user_data.clear()

    else:
        await update.message.reply_text("Use /start", reply_markup=kb_menu())


# ── Error handler ─────────────────────────────────────────────────────────────

async def on_error(update, context):
    logger.error("Update %s caused error", update, exc_info=context.error)


# ── Main ──────────────────────────────────────────────────────────────────────

def main():
    if not BOT_TOKEN:
        print("❌ telegram_bot.token not set in config.yaml"); return

    app = Application.builder().token(BOT_TOKEN).build()
    app.add_handler(CommandHandler("start",   cmd_start))
    app.add_handler(CommandHandler("cancel",  cmd_cancel))
    app.add_handler(CommandHandler("login",   cmd_login))
    app.add_handler(CommandHandler("logout",  cmd_logout))
    app.add_handler(CommandHandler("servers", cmd_servers))
    app.add_handler(CallbackQueryHandler(on_button))
    app.add_handler(MessageHandler(
        (filters.TEXT & ~filters.COMMAND) | filters.Document.ALL,
        on_message))
    app.add_error_handler(on_error)

    logger.info("Bot starting. Primary: %s", PRIMARY_URL)
    app.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == "__main__":
    main()
