# ── Config ────────────────────────────────────────────────────────────────────

def load_config() -> dict:
    path = Path("config.yaml")
    if not path.exists():
        raise RuntimeError(f"Missing config file: {path}")
    raw = yaml.safe_load(path.read_text()) or {}
    bot = raw.get("telegram_bot", {})
    return {
        "TOKEN":       bot.get("token"),
        "PRIMARY_URL": bot.get("primary_url", "http://127.0.0.1:51700"),
    }

cfg         = load_config()
BOT_TOKEN   = cfg["TOKEN"]
PRIMARY_URL = cfg["PRIMARY_URL"].rstrip("/")


# ── Per-user session store ────────────────────────────────────────────────────
# Keyed by Telegram user_id (int).
# Each entry: {
#   "primary_token": str,     # bearer token for the primary srapi
#   "servers":       list,    # [{id, name, url, token}, …] from /api/serverlist
#   "active_id":     str,     # currently selected server id
# }
_sessions: dict[int, dict] = {}


def get_session(uid: int) -> Optional[dict]:
    return _sessions.get(uid)


def set_session(uid: int, data: dict):
    _sessions[uid] = data


def clear_session(uid: int):
    _sessions.pop(uid, None)


def active_server(uid: int) -> Optional[dict]:
    sess = get_session(uid)
    if not sess:
        return None
    aid     = sess.get("active_id")
    servers = sess.get("servers", [])
    if aid:
        s = next((s for s in servers if s["id"] == aid), None)
        if s:
            return s
    return servers[0] if servers else None


def primary_server(uid: int) -> Optional[dict]:
    """Synthetic server entry that always talks to the primary node."""
    sess = get_session(uid)
    if not sess:
        return None
    return {"id": "__primary__", "name": "Primary",
            "url": PRIMARY_URL, "token": sess["primary_token"]}


# ── API client ────────────────────────────────────────────────────────────────

class ApiError(Exception):
    def __init__(self, status: int, detail: str):
        self.status = status
        self.detail = detail
        super().__init__(f"HTTP {status}: {detail}")


async def _req(method: str, server: dict, path: str, **kwargs):
    url     = server["url"].rstrip("/") + path
    headers = {"Authorization": f"Bearer {server['token']}"}
    timeout = aiohttp.ClientTimeout(total=60)
    async with aiohttp.ClientSession(timeout=timeout) as sess:
        async with sess.request(method, url, headers=headers, **kwargs) as r:
            if r.content_type and "octet-stream" in r.content_type:
                return await r.read()
            body = await r.json(content_type=None)
            if r.status >= 400:
                detail = body.get("detail", str(body)) if isinstance(body, dict) else str(body)
                raise ApiError(r.status, detail)
            return body


async def api_get   (sv, path, **kw): return await _req("GET",    sv, path, **kw)
async def api_post  (sv, path, **kw): return await _req("POST",   sv, path, **kw)
async def api_put   (sv, path, **kw): return await _req("PUT",    sv, path, **kw)
async def api_delete(sv, path, **kw): return await _req("DELETE", sv, path, **kw)
async def fetch_serverlist(primary_token: str) -> list[dict]:
    sv = {"url": PRIMARY_URL, "token": primary_token}
    result = await api_get(sv, "/api/serverlist")
    return result if isinstance(result, list) else []

