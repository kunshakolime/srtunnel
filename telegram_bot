# ── Commands ──────────────────────────────────────────────────────────────────

async def cmd_start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await show_menu(update, context)

async def cmd_cancel(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await show_menu(update, context, notice="❌ Cancelled")

async def cmd_login(update: Update, context: ContextTypes.DEFAULT_TYPE):
    uid = update.effective_user.id
    # Check if a token was provided: /login <token>
    if not context.args:
        await update.message.reply_text(
            "❌ Usage: `/login <your_bearer_token>`\n\nExample:\n`/login eyJhbG...`",
            parse_mode="Markdown"
        )
        return
    primary_token = context.args[0]
    
    try:
        # Fetch servers using the provided token to verify it [cite: 269]
        servers = await fetch_serverlist(primary_token)
        
        # Initialize the session [cite: 262]
        set_session(uid, {
            "primary_token": primary_token,
            "servers":       servers,
            "active_id":     servers[0]["id"] if servers else None
        })
        
        await show_menu(update, context, notice="✅ Login successful via token!")
        
    except ApiError as e:
        await update.message.reply_text(f"❌ Login failed: `{e.detail}`", parse_mode="Markdown")
    except Exception as e:
        await update.message.reply_text(f"❌ Error: `{e}`")
async def cmd_logout(update: Update, context: ContextTypes.DEFAULT_TYPE):
    uid = update.effective_user.id
    clear_session(uid)
    _cancel_menu_task(context)
    context.user_data.clear()
    await update.message.reply_text("✅ Logged out. Use /login to reconnect.")

async def cmd_servers(update: Update, context: ContextTypes.DEFAULT_TYPE):
    uid  = update.effective_user.id
    sess = get_session(uid)
    if not sess:
        await update.message.reply_text("Not logged in. Use /login."); return
    servers = sess.get("servers", [])
    aid     = sess.get("active_id")
    lines   = ["*🖥 Available Servers*\n"]
    for s in servers:
        mark = "✅" if s["id"] == aid else "•"
        lines.append(f"{mark} *{s['name']}*\n   `{s['url']}`")
    await update.message.reply_text("\n".join(lines), parse_mode="Markdown",
                                    reply_markup=kb([("🖥 Switch",  "switch_server"),
                                                     ("🔙 Menu",    "back_to_menu")]))


# ── Button dispatcher ─────────────────────────────────────────────────────────

async def on_button(update: Update, context: ContextTypes.DEFAULT_TYPE):
    q   = update.callback_query
    uid = q.from_user.id
    try: await q.answer()
    except Exception: pass

    data = q.data

    # ── Pre-session callbacks ──────────────────────────────────────────────────

    if data == "back_to_menu":
        await show_menu(update, context); return

    if data == "menu_refresh":
        await show_menu(update, context, fast_burst=True); return

    # ── Session required ───────────────────────────────────────────────────────
    sess = get_session(uid)
    if not sess:
        await q.edit_message_text("⚠️ Session expired. Please /login again.",
                                  reply_markup=kb([("🔐 Login", "login_start")]))
        return

    # ── Server switcher ────────────────────────────────────────────────────────
    if data == "switch_server":
        servers = sess.get("servers", [])
        aid     = sess.get("active_id")
        rows    = [[InlineKeyboardButton(
                        ("✅ " if s["id"] == aid else "") + s["name"],
                        callback_data=f"selserver_{s['id']}")] for s in servers]
        rows.append([InlineKeyboardButton("🔄 Refresh", callback_data="refresh_serverlist"),
                     InlineKeyboardButton("🔙 Menu",    callback_data="back_to_menu")])
        await q.edit_message_text("*🖥 Select Server*", parse_mode="Markdown",
                                  reply_markup=InlineKeyboardMarkup(rows))
        return

    if data.startswith("selserver_"):
        sid = data[10:]
        s   = next((s for s in sess.get("servers", []) if s["id"] == sid), None)
        if s:
            sess["active_id"] = sid
            set_session(uid, sess)
            await show_menu(update, context, notice=f"✅ Switched to *{s['name']}*")
        else:
            await q.edit_message_text("❌ Server not found", reply_markup=kb_menu())
        return

    if data == "refresh_serverlist":
        try:
            servers = await fetch_serverlist(sess["primary_token"])
            sess["servers"] = servers
            ids = {s["id"] for s in servers}
            if sess.get("active_id") not in ids:
                sess["active_id"] = servers[0]["id"] if servers else None
            set_session(uid, sess)
            await q.edit_message_text(
                f"✅ Refreshed — {len(servers)} server(s)",
                reply_markup=kb([("🖥 Switch", "switch_server"), ("🔙 Menu", "back_to_menu")]))
        except ApiError as e:
            await q.edit_message_text(f"❌ {e.detail}", reply_markup=kb_menu())
        return

    # Resolve active server for all remaining actions
    server = active_server(uid)
    if not server:
        await q.edit_message_text("⚠️ No active server.",
                                  reply_markup=kb([("🔐 Login", "login_start")])); return

    def leave_menu():
        context.user_data.pop("menu_msg_id", None)

    try:
        await _dispatch(q, update, context, uid, server, sess, data, leave_menu)
    except ApiError as e:
        await q.edit_message_text(f"❌ API {e.status}:\n`{e.detail}`",
                                  parse_mode="Markdown", reply_markup=kb_menu())
    except Exception as e:
        logger.exception("Button error")
        await q.edit_message_text(f"❌ Unexpected error:\n`{e}`",
                                  parse_mode="Markdown", reply_markup=kb_menu())


async def _dispatch(q, update, context, uid, server, sess, data, leave_menu):  # noqa: C901

    # ══════════════════════════════════════════════════════════════════════════
    # SYNC
    # ══════════════════════════════════════════════════════════════════════════
    if data == "sync_now":
        leave_menu()
        r  = await api_post(server, "/api/sync")
        dc = r.get("deleted_count", 0) if isinstance(r, dict) else 0
        await q.edit_message_text("✅ Synced" + (f"\n{dc} expired removed" if dc else ""),
                                  reply_markup=kb_menu())

    # ══════════════════════════════════════════════════════════════════════════
    # SPEED TEST
    # ══════════════════════════════════════════════════════════════════════════
    elif data == "speedtest":
        leave_menu()
        await q.edit_message_text("*🚀 Speed Test*\n\n_Running… (30–60 s)_",
                                  parse_mode="Markdown",
                                  reply_markup=kb([("❌ Cancel", "back_to_menu")]))
        chat_id, msg_id = q.message.chat_id, q.message.message_id
        kb_done = kb([("🔄 Test Again", "speedtest"), ("🔙 Menu", "back_to_menu")])

        async def run_st():
            try:
                r    = await api_get(server, "/api/speedtest")
                dl   = r.get("download", {}).get("bandwidth", 0)
                ul   = r.get("upload",   {}).get("bandwidth", 0)
                ping = (r.get("ping") or {}).get("latency")
                def mbps(b): return f"{b*8/1_000_000:.1f} Mbps" if b else "?"
                msg  = (f"*🚀 Speed Test*\n\n"
                        f"⬇️ Download: `{mbps(dl)}`\n"
                        f"⬆️ Upload: `{mbps(ul)}`")
                if ping: msg += f"\n📶 Ping: `{ping:.1f} ms`"
            except ApiError as e: msg = f"❌ `{e.detail}`"
            except Exception  as e: msg = f"❌ `{e}`"
            try:
                await context.bot.edit_message_text(msg, chat_id=chat_id, message_id=msg_id,
                                                    parse_mode="Markdown", reply_markup=kb_done)
            except Exception: pass

        asyncio.create_task(run_st())

    # ══════════════════════════════════════════════════════════════════════════
    # BACKUP
    # ══════════════════════════════════════════════════════════════════════════
    elif data == "backup_menu":
        leave_menu()
        await q.edit_message_text(
            "*💾 Backup & Restore*", parse_mode="Markdown",
            reply_markup=kb([("📤 Download DB",  "backup_send")],
                            [("♻️ Restore DB",    "backup_restore")],
                            [("🔁 Merge DB",      "backup_merge")],
                            [("🔙 Menu",          "back_to_menu")]))

    elif data == "backup_send":
        raw = await api_get(server, "/api/backup")
        await q.message.reply_document(
            document=io.BytesIO(raw if isinstance(raw, bytes) else b""),
            filename="users.db",
            caption=f"📦 `{server['name']}` — users.db", parse_mode="Markdown")
        await show_menu(update, context)

    elif data == "backup_restore":
        leave_menu()
        context.user_data["action"] = "restore_db"
        await q.edit_message_text(
            "*♻️ Restore DB*\n\nSend a `users.db` file.\n⚠️ This *replaces* the current database.\n\n/cancel to abort",
            parse_mode="Markdown", reply_markup=kb_menu())

    elif data == "backup_merge":
        leave_menu()
        context.user_data["action"] = "merge_db"
        await q.edit_message_text(
            "*🔁 Merge DB*\n\nSend a `users.db` file — users will be merged in.\n\n/cancel to abort",
            parse_mode="Markdown", reply_markup=kb_menu())

    # ══════════════════════════════════════════════════════════════════════════
    # USERS
    # ══════════════════════════════════════════════════════════════════════════
    elif data == "manage_users":
        leave_menu()
        users = await api_get(server, "/api/users")
        if not users:
            await q.edit_message_text("ℹ️ No users", reply_markup=kb_menu()); return
        context.user_data["user_list"] = users
        msg = "*All Users*\n\n"
        for i, u in enumerate(users, 1):
            icon = "✅" if u.get("status") == "Active" else "❌"
            temp = "⏱" if u.get("temporary") else ""
            c    = u.get("connections", 0)
            ml   = u.get("max_logins")
            conn = f"{c}/{ml}🔌" if ml else f"{c}🔌"
            msg += f"`{i:02d}` {icon}{temp} {conn} `{u['username']}` • `{u['password']}`\n"
        msg += f"\n*Total: {len(users)}*"
        rows = [
            [InlineKeyboardButton(str(n), callback_data=f"usernum_{n}")
