# ── Menu text ─────────────────────────────────────────────────────────────────

async def menu_text(server: dict, live="normal") -> str:
    try:
        info = await api_get(server, "/api/system")
    except ApiError as e:
        return f"⚠️ *{server['name']}*\n\nAPI unreachable:\n`{e.detail}`"
    except Exception as e:
        return f"⚠️ *{server['name']}*\n\n`{e}`"

    def fmt_gb(v):
        if v is None: return "?"
        return f"{int(v*1024)}MB" if v < 1 else f"{v:.1f}GB"

    bw    = info.get("bandwidth") or {}
    lines = [f"🤖 *{server['name']}*", f"🌐 `{info.get('ip','?')}`"]
    if bw:
        lines += [f"⬇️ `{bw.get('rx','?')}`", f"⬆️ `{bw.get('tx','?')}`"]

    cpu = info.get("cpu");    ru = info.get("ram_used"); rt = info.get("ram_total")
    rp  = info.get("ram_percent"); du = info.get("disk_used")
    dt  = info.get("disk_total"); dp = info.get("disk_percent")
    if cpu is not None: lines.append(f"💻 CPU: {cpu:.0f}%")
    if ru  is not None: lines.append(f"🧠 RAM: {fmt_gb(ru)}/{int(round(rt or 0))}GB • {rp:.0f}%")
    if du  is not None: lines.append(f"💾 Disk: {fmt_gb(du)}/{int(round(dt or 0))}GB • {dp:.0f}%")

    try:
        users  = await api_get(server, "/api/users")
        active = sum(1 for u in users if u.get("status") == "Active")
        lines += [f"👥 Users: {active}/{len(users)} active",
                  f"🔌 Connections: {info.get('connections', 0)}"]
    except Exception:
        pass

    lines.append("\n⚡ _Fast refresh_" if live == "fast" else "\n🔄 _Auto-refresh_")
    return "\n".join(lines)


# ── show_menu ─────────────────────────────────────────────────────────────────

def _cancel_menu_task(context: ContextTypes.DEFAULT_TYPE):
    t = context.user_data.pop("menu_task", None)
    if t and not t.done():
        t.cancel()


async def show_menu(update: Update, context: ContextTypes.DEFAULT_TYPE,
                    notice: str = "", fast_burst: bool = False):
    _cancel_menu_task(context)
    context.user_data.clear()

    uid  = update.effective_user.id
    sess = get_session(uid)

    if not sess:
        # Updated welcome message to remove the login button [cite: 280]
        text = "👋 *Welcome!*\n\nPlease use `/login <token>` to authenticate."
        if update.callback_query:
            await update.callback_query.edit_message_text(text, parse_mode="Markdown")
        else:
            await update.message.reply_text(text, parse_mode="Markdown")
        return

    server = active_server(uid)
    multi  = len(sess.get("servers", [])) > 1
    mode   = "fast" if fast_burst else "normal"
    initial = (f"{notice}\n\n" if notice else "") + await menu_text(server, live=mode)
    markup  = build_main_kb(multi=multi)

    if update.callback_query:
        await update.callback_query.edit_message_text(initial, parse_mode="Markdown",
                                                      reply_markup=markup)
        chat_id = update.callback_query.message.chat_id
        msg_id  = update.callback_query.message.message_id
    else:
        sent    = await update.message.reply_text(initial, parse_mode="Markdown",
                                                  reply_markup=markup)
        chat_id = sent.chat_id
        msg_id  = sent.message_id

    context.user_data["menu_msg_id"] = msg_id

    async def loop():
        NORMAL, FAST, FAST_DUR = 60, 3, 15
        fast = fast_burst; fast_rem = FAST_DUR if fast else 0; last = initial
        try:
            while True:
                if fast and fast_rem > 0:
                    await asyncio.sleep(FAST); fast_rem -= FAST
                    m = "fast" if fast_rem > 0 else "normal"
                    if fast_rem <= 0: fast = False
                else:
                    fast = False; await asyncio.sleep(NORMAL); m = "normal"

                if context.user_data.get("menu_msg_id") != msg_id:
                    return
                sv = active_server(uid)
                if not sv: return
                t = await menu_text(sv, live=m)
                if t != last:
                    try:
                        s2 = get_session(uid)
                        await context.bot.edit_message_text(
                            t, chat_id=chat_id, message_id=msg_id,
                            parse_mode="Markdown",
                            reply_markup=build_main_kb(
                                multi=len(s2.get("servers", [])) > 1 if s2 else False))
                        last = t
                    except Exception: pass
        except asyncio.CancelledError: pass

    context.user_data["menu_task"] = asyncio.create_task(loop())


