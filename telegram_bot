def fmt_user(user):
    icon    = "✅" if user["status"] == "Active" else "❌"
    expires = user["expires"][:10] if user["expires"] else "Never"
    conns   = system.user_connections(user["username"])
    limit   = f"/{user['max_logins']}" if user["max_logins"] else "/∞"
    return (
        f"{icon} *{user['username']}*\n\n"
        f"`{user['password']}`\n"
        f"Expires: {expires}\n"
        f"{'Temporary' if user['temporary'] else 'Permanent'}\n"
        f"Connections: {conns}{limit}"
    )


def menu_text(live="normal"):
    ip   = system.public_ip()
    info = system.system_info()
    bw   = system.bandwidth_usage(IFACE)
    users  = core.get_users()
    active = sum(1 for u in users if u["status"] == "Active")
    conns  = system.total_connections()

    def fmt_gb(v): return f"{int(v*1024)}mb" if v < 1 else f"{v:.1f}GB"

    lines = ["🤖 *VPN User Management Bot*", "☠ @kunshakolime", f"🌐 Server: `{ip}`"]
    if DOMAIN: lines.append(f"🔗 Domain: `{DOMAIN}`")
    if DNSTT:  lines.append(f"📡 DNSTT: `{DNSTT}`")
    if KEY:
        try:    key_val = Path(KEY).read_text().strip() if os.path.exists(KEY) else KEY
        except: key_val = KEY
        lines.append(f"🔑 Key: `{key_val}`")
    if bw:
        dl = f'`{bw["rx"]}`' + (f" / {BW_DOWN}" if BW_DOWN else "")
        ul = f'`{bw["tx"]}`' + (f" / {BW_UP}"   if BW_UP   else "")
        lines += [f"⬇️ {dl}", f"⬆️ {ul}"]
    if info:
        lines += [
            f"💻 CPU: {info['cpu']:.0f}%",
            f"🧠 RAM: {fmt_gb(info['ram_used'])}/{int(round(info['ram_total']))}GB • {info['ram_percent']:.0f}%",
            f"💾 Disk: {fmt_gb(info['disk_used'])}/{int(round(info['disk_total']))}GB • {info['disk_percent']:.0f}%",
        ]
    lines += [f"👥 Users: {active}/{len(users)} active", f"🔌 Connections: {conns}"]
    lines.append("\n⚡ _Fast refresh_" if live == "fast" else "\n🔄 _Auto-refresh_")
    return "\n".join(lines)


