def _cancel_menu_task(context):
    task = context.user_data.pop("menu_task", None)
    if task and not task.done():
        task.cancel()


async def show_menu(update: Update, context: ContextTypes.DEFAULT_TYPE, text=None, fast_burst=False):
    _cancel_menu_task(context)
    context.user_data.clear()

    mode    = "fast" if fast_burst else "normal"
    initial = text or menu_text(live=mode)
    if update.callback_query:
        await update.callback_query.edit_message_text(initial, reply_markup=kb_main(), parse_mode="Markdown")
        chat_id = update.callback_query.message.chat_id
        msg_id  = update.callback_query.message.message_id
    else:
        sent    = await update.message.reply_text(initial, reply_markup=kb_main(), parse_mode="Markdown")
        chat_id = sent.chat_id
        msg_id  = sent.message_id

    if text:
        fast_burst = False

    context.user_data["menu_msg_id"] = msg_id

    async def menu_loop():
        NORMAL_REFRESH, FAST_REFRESH, FAST_DURATION = 60, 3, 15
        fast = fast_burst
        fast_remaining = FAST_DURATION if fast else 0
        last_text = initial
        try:
            while True:
                if fast and fast_remaining > 0:
                    await asyncio.sleep(FAST_REFRESH)
                    fast_remaining -= FAST_REFRESH
                    mode = "fast" if fast_remaining > 0 else "normal"
                    if fast_remaining <= 0:
                        fast = False
                else:
                    fast = False
                    await asyncio.sleep(NORMAL_REFRESH)
                    mode = "normal"

                if context.user_data.get("menu_msg_id") != msg_id:
                    return

                t = menu_text(live=mode)
                if t != last_text:
                    try:
                        await context.bot.edit_message_text(
                            t, chat_id=chat_id, message_id=msg_id,
                            parse_mode="Markdown", reply_markup=kb_main())
                        last_text = t
                    except Exception:
                        pass
        except asyncio.CancelledError:
            pass

    context.user_data["menu_task"] = asyncio.create_task(menu_loop())


async def show_user(query, username, context: ContextTypes.DEFAULT_TYPE = None):
    if context is not None:
        context.user_data.pop("menu_msg_id", None)
    user = core.get_user(username)
    if not user:
        await query.edit_message_text("❌ User not found", reply_markup=kb_users())
        return
    await query.edit_message_text(fmt_user(user), parse_mode="Markdown",
                                  reply_markup=kb_user_actions(username, user["temporary"], user["status"] == "Active"))


def parse_positive_int(text):
    try:
        n = int(text)
        if n <= 0: raise ValueError
        return n
    except (ValueError, TypeError):
        raise ValueError("❌ Invalid number (must be > 0)")


