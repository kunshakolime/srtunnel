def fmt_user(u: dict) -> str:
    icon    = "✅" if u.get("status") == "Active" else "❌"
    expires = (u.get("expires") or "")[:10] or "Never"
    conns   = u.get("connections", 0)
    ml      = u.get("max_logins")
    limit   = f"/{ml}" if ml else "/∞"
    svcs    = u.get("services") or []
    svc_str = f"\nServices: `{'`, `'.join(svcs)}`" if svcs else ""
    return (f"{icon} *{u['username']}*\n\n"
            f"`{u['password']}`\n"
            f"Expires: {expires}\n"
            f"{'Temporary' if u.get('temporary') else 'Permanent'}\n"
            f"Connections: {conns}{limit}"
            f"{svc_str}")


