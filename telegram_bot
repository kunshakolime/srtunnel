async def cmd_start(update, context):
    if not await check_admin(update): return
    await show_menu(update, context)

async def cmd_cancel(update, context):
    if not await check_admin(update): return
    await show_menu(update, context, "❌ Cancelled")


async def on_button(update: Update, context: ContextTypes.DEFAULT_TYPE):
    q = update.callback_query
    try: await q.answer()
    except Exception: pass

    if not is_admin(q.from_user.id):
        try: await q.edit_message_text("⛔ Unauthorized")
        except Exception: pass
        return

    data = q.data

    def leave_menu():
        context.user_data.pop("menu_msg_id", None)

    if data == "back_to_menu":
        await show_menu(update, context)

    elif data == "sync_now":
        leave_menu()
        r = core.sync()
        msg = "✅ Synced"
        if r["deleted_count"]: msg += f"\n{r['deleted_count']} expired user(s) removed"
        await q.edit_message_text(msg, reply_markup=kb_menu())

    elif data == "menu_refresh":
        await show_menu(update, context, fast_burst=True)

    elif data == "speedtest":
        _cancel_menu_task(context)
        leave_menu()
        old_proc = context.user_data.pop("speedtest_proc", None)
        if old_proc:
            try: old_proc.kill()
            except Exception: pass

        proc, progress_file = st.start()
        context.user_data.update(speedtest_proc=proc, speedtest_file=progress_file, speedtest_cancelled=False)

        kb_cancel = InlineKeyboardMarkup([[InlineKeyboardButton("❌ Cancel", callback_data="speedtest_cancel")]])
        kb_done   = InlineKeyboardMarkup([[
            InlineKeyboardButton("🔄 Test Again", callback_data="speedtest"),
            InlineKeyboardButton("🔙 Menu",       callback_data="back_to_menu"),
        ]])
        chat_id, msg_id = q.message.chat_id, q.message.message_id

        async def run_and_update():
            last_msg = last_p = None
            while proc.poll() is None:
                await asyncio.sleep(1)
                if context.user_data.get("speedtest_cancelled"): return
                p = st.poll(progress_file)
                if p:
                    last_p = p
                    pct   = p.get("pct", 0)
                    speed = p.get("speed", "…")
                    eta   = p.get("eta")
                    phase = p.get("phase", "")
                    bar   = "█" * (pct // 10) + "░" * (10 - pct // 10)

                    if phase in ("starting", "ping"):
                        status = f"📶 {phase.capitalize()}…"
                    elif eta:
                        status = f"⬇️ `{speed}` • ETA {eta}"
                    else:
                        status = f"⬇️ `{speed}`"

                    msg = f"*🚀 Speed Test*\n\n`{bar}` {pct}%\n{status}"
                    if msg != last_msg:
                        try:
                            await context.bot.edit_message_text(msg, chat_id=chat_id, message_id=msg_id,
                                parse_mode="Markdown", reply_markup=kb_cancel)
                            last_msg = msg
                        except Exception: pass

            result = st.parse_result(progress_file)   # read BEFORE cleanup
            st.cleanup(progress_file)
            context.user_data.pop("speedtest_proc", None)
            context.user_data.pop("speedtest_file", None)
            if proc.returncode not in (0, None):
                final = "🚫 *Cancelled*"
            else:
                if result:
                    final = st.format_result(result, BW_DOWN, BW_UP)
                elif last_p:
                    dl    = f"⬇️ `{last_p.get('speed', '?')}`" + (f" / {BW_DOWN}" if BW_DOWN else "")
                    final = f"*🚀 Speed Test Result*\n\n{dl}"
                else:
                    final = "❌ Speed test failed"
            try:
                await context.bot.edit_message_text(final, chat_id=chat_id, message_id=msg_id,
                    parse_mode="Markdown", reply_markup=kb_done)
            except Exception: pass

        await q.edit_message_text("*🚀 Speed Test*\n\n`░░░░░░░░░░` 0%",
            parse_mode="Markdown", reply_markup=kb_cancel)
        asyncio.create_task(run_and_update())

    elif data == "speedtest_cancel":
        context.user_data["speedtest_cancelled"] = True
        proc = context.user_data.pop("speedtest_proc", None)
        path = context.user_data.pop("speedtest_file", None)
        if proc:
            try: proc.kill()
            except Exception: pass
        if path:
            st.cleanup(path)  # fixed: was system.speedtest_cleanup
        await q.edit_message_text("🚫 *Cancelled*", parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup([[
                InlineKeyboardButton("🔄 Test Again", callback_data="speedtest"),
                InlineKeyboardButton("🔙 Menu",       callback_data="back_to_menu"),
            ]]))

    elif data == "backup_menu":
        leave_menu()
        await q.edit_message_text("*Database Backup*\n\nChoose an option:", parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup([
                [InlineKeyboardButton("📤 Backup DB",  callback_data="backup_send")],
                [InlineKeyboardButton("♻️ Restore DB", callback_data="backup_restore")],
                [InlineKeyboardButton("🔁 Sync DB",    callback_data="backup_sync")],
                [InlineKeyboardButton("🔙 Menu",       callback_data="back_to_menu")],
            ]))

    elif data == "backup_send":
        db = cfg["DB_FILE"]
        if not os.path.exists(db):
            await q.edit_message_text("❌ Database not found", reply_markup=kb_menu())
            return
        await q.message.reply_document(document=open(db, "rb"), filename="users.db", caption="📦 users.db backup")
        await show_menu(update, context)

    elif data == "backup_restore":
        leave_menu()
        context.user_data["action"] = "restore_db"
        await q.edit_message_text("*Send users.db file*\n\nThis will REPLACE current database.\n\n/cancel to abort",
                                   parse_mode="Markdown", reply_markup=kb_menu())

    elif data == "backup_sync":
        leave_menu()
        context.user_data["action"] = "sync_db"
        await q.edit_message_text(
            "*Send users.db file*\n\nUsers from the file will be merged into the current database.\n\n"
            "/cancel to go back",
            parse_mode="Markdown", reply_markup=kb_menu())

    elif data == "manage_users":
        leave_menu()
        users = core.get_users()
        if not users:
            await q.edit_message_text("ℹ️ No users", reply_markup=kb_menu())
            return
        context.user_data["user_list"] = users
        msg = "*All Users*\n\n"
        for i, u in enumerate(users, 1):
            icon = "✅" if u["status"] == "Active" else "❌"
            temp = "⏱" if u["temporary"] else ""
            c    = system.user_connections(u["username"])
            conn = f"{c}/{u['max_logins']}🔌" if u["max_logins"] else f"{c}🔌"
            msg += f"`{i:02d}` {icon}{temp} {conn} `{u['username']}` • `{u['password']}`\n"
        msg += f"\n*Total: {len(users)} users*\nEnter user number to manage:"
        keyboard = [
            [InlineKeyboardButton(str(n), callback_data=f"usernum_{n}") for n in range(s, min(s+9, len(users)+1))]
            for s in range(1, len(users)+1, 9)
        ] + [[InlineKeyboardButton("🔙 Menu", callback_data="back_to_menu")]]
        await q.edit_message_text(msg, parse_mode="Markdown", reply_markup=InlineKeyboardMarkup(keyboard))

    elif data.startswith("usernum_"):
        users = context.user_data.get("user_list", [])
        try:
            idx = int(data[8:]) - 1
            await show_user(q, users[idx]["username"], context)
        except (ValueError, IndexError):
            await q.edit_message_text("❌ Invalid selection", reply_markup=kb_users())

    elif data.startswith("select_"):    await show_user(q, data[7:], context)
    elif data.startswith("toggle_"):    core.toggle_temporary(data[7:]); await show_user(q, data[7:], context)

    elif data.startswith("maxlog_"):
        username = data[7:]
        user = core.get_user(username)
        cur  = f"Current: {user['max_logins']}" if user and user["max_logins"] else "Current: Unlimited"
        context.user_data.update(action="set_maxlogins", maxlogins_username=username)
        await q.edit_message_text(
            f"*Max Logins: {username}*\n\n{cur}\n\nSend a number to set a limit, or `0` to remove it.\n\n/cancel to go back",
            parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Back", callback_data=f"select_{username}")]]))

    elif data.startswith("pwd_") and data not in ("pwd_random", "pwd_custom"):
        username = data[4:]
        context.user_data["change_password_username"] = username
        await q.edit_message_text(f"*Change Password: {username}*\n\nChoose an option:", parse_mode="Markdown",
