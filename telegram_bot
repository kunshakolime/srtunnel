                [InlineKeyboardButton("🎲 Random", callback_data="pwd_random"),
                 InlineKeyboardButton("✍️ Custom", callback_data="pwd_custom")],
                [InlineKeyboardButton("🔙 Back",   callback_data=f"select_{username}")],
            ]))

    elif data == "pwd_random":
