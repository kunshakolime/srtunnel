[Unit]
Description=badvpn
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/srtunnel
ExecStart=${BIN_DIR}/badvpn-udpgw --listen-addr 127.0.0.1:7300 --max-clients 1000 --max-connections-for-client 1000 --client-socket-sndbuf 0 --udp-mtu 9000
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target