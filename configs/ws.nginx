# ── nginx stream front for ws-sr ────────────────────────────────────────────
# All public ports proxy to ws-sr's private upstream on 127.0.0.1:18081.
# Deployed by scripts/debinstall.sh → /etc/nginx/stream-available/ws,
# symlinked from /etc/nginx/stream-enabled/ws.

log_format ws_bytes '$remote_addr [$time_local] $protocol $status '
                    '$bytes_sent $bytes_received $session_time';

limit_conn_zone $binary_remote_addr zone=ws_ip:10m;

# ── all plain ports: production (80, 2086, 8000, 8080, 8880) + test (18080) ─
server {
    listen 80;
    listen 2086;
    listen 8000;
    listen 8080;
    listen 8880;
    listen 18080;
    proxy_pass 127.0.0.1:18081;

    proxy_connect_timeout 5s;
    proxy_timeout 300s;              # idle timeout, mirrors ws-sr max_idle
    proxy_socket_keepalive on;
    tcp_nodelay on;

    limit_conn ws_ip 10;             # per-IP cap (ws-sr used a global 1000 cap)
    access_log /var/log/nginx/ws-access.log ws_bytes;
}

# ── all TLS ports: production 8446 + test 18443 ─────────────────────────────
server {
    listen 8446 ssl;
    listen 18443 ssl;
    ssl_certificate     ${BOT_DIR}/server.crt;
    ssl_certificate_key ${BOT_DIR}/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    proxy_pass 127.0.0.1:18081;

    proxy_connect_timeout 5s;
    proxy_timeout 300s;
    proxy_socket_keepalive on;
    tcp_nodelay on;

    limit_conn ws_ip 10;
    access_log /var/log/nginx/ws-access.log ws_bytes;
}
