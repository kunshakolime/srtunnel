log_format ws_bytes '$remote_addr [$time_local] $protocol $status '
                    '$bytes_sent $bytes_received $session_time';

limit_conn_zone $binary_remote_addr zone=ws_ip:10m;

map $ssl_preread_server_name $sni_backend {
    ssh.example.com         127.0.0.1:8443;
    default                   127.0.0.1:9443;
}

server {
    listen 2086;
    listen 8000;
    listen 8080;
    listen 8880;
    proxy_pass 127.0.0.1:18081;

    proxy_connect_timeout 5s;
    proxy_timeout 300s;
    proxy_socket_keepalive on;
    tcp_nodelay on;

    limit_conn ws_ip 10;
    access_log /var/log/nginx/ws-access.log ws_bytes;
}

server {
    listen 8446 ssl;
    ssl_certificate     ${BOT_DIR}/server.crt;
    ssl_certificate_key ${BOT_DIR}/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    proxy_pass 127.0.0.1:18081;

    proxy_connect_timeout 5s;
    proxy_timeout 300s;
    proxy_socket_keepalive on;
    tcp_nodelay on;

    limit_conn ws_ip 10;
    access_log /var/log/nginx/ws-access.log ws_bytes;
}

server {
    listen 443;
    ssl_preread on;
    proxy_pass $sni_backend;
    proxy_connect_timeout 5s;
    proxy_timeout 300s;
    proxy_socket_keepalive on;
}
