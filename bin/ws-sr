#!/usr/bin/env python3
"""
WebSocket Tunnel Server
Tunnels WebSocket/HTTP traffic to a backend service (SSH, etc.)

Single-threaded selectors event loop: one thread serves all connections,
so memory per connection is two sockets plus a few KB of buffers.
"""

BANNER = """
╔══════════════════════════════════════════════════════════════╗
║           WebSocket Tunnel Server by kunshakolime            ║
║                    Version 4.0 - Event Loop                  ║
╚══════════════════════════════════════════════════════════════╝"""

import sys
import selectors
import signal
import argparse
import logging
import yaml
import socket
import errno
import time
import hashlib
import base64
from pathlib import Path
from typing import Optional, Dict, Any

# show this process as "ws-sr", not "python3" (PR_SET_NAME)
import ctypes
try:
    ctypes.CDLL(None).prctl(15, b"ws-sr", 0, 0, 0)
except Exception:
    pass

# CONFIG
class Config:

    def __init__(self, config_file: str = 'config.yaml'):
        self.config_file = config_file
        self.data = self._load_config()
        self._cache()

    def _load_config(self) -> Dict[str, Any]:
        config_path = Path(self.config_file)
        if not config_path.exists():
            logging.error(f"Config file not found: {self.config_file}")
            time.sleep(5)
            sys.exit(1)
        try:
            with open(config_path, 'r', encoding='utf-8') as f:
                raw = yaml.safe_load(f) or {}
            data = raw.get("websocket")
            if not data:
                logging.error(f"{self.config_file} missing 'websocket' block.")
                time.sleep(5)
                sys.exit(1)
        except Exception as e:
            logging.error(f"Failed to read {self.config_file}: {e}")
            time.sleep(5)
            sys.exit(1)
        return data

    def _cache(self):
        self.buffer_size        = self.get('server',      'buffer_size',          default=65536)
        self.max_connections    = self.get('server',      'max_connections')      or 1000
        self.bind_address       = self.get('server',      'bind_address')
        self.backend_host       = self.get('backend',     'host')
        self.backend_port       = self.get('backend',     'port')
        self.backend_retries    = self.get('backend',     'max_retries')          or 3
        self.backend_delay      = self.get('backend',     'retry_delay')          or 0.5
        self.timeout_initial    = self.get('timeouts',    'initial')              or 3
        self.timeout_conn       = self.get('timeouts',    'connection')           or 60
        self.timeout_split      = self.get('timeouts',    'split')                or 2
        self.timeout_idle       = self.get('timeouts',    'max_idle',             default=300)
        self.response_mode      = self.get('http',        'response_mode')
        self.response_text      = self.get('http',        'custom_response_text', default='')
        self.handle_split       = self.get('http',        'handle_split')
        self.enable_nodelay     = self.get('performance', 'enable_nodelay')
        self.log_connections    = self.get('monitoring',  'log_connections')
        self.show_bytes_human   = self.get('monitoring',  'show_bytes_human',     default=True)
        self.stats_interval     = self.get('monitoring',  'stats_interval')
        self.ignore_early_reset = self.get('errors',      'ignore_early_reset')

    def get(self, *keys, default=None):
        value = self.data
        for key in keys:
            if not isinstance(value, dict) or key not in value:
                return default
            value = value[key]
        return value

    def setup_logging(self):
        log_level = getattr(logging, self.get('logging', 'level', default='INFO').upper())
        fmt       = ('%(levelname)s: %(message)s' if self.get('logging', 'format') == 'simple'
                     else '%(asctime)s [%(levelname)s] %(message)s')
        handler   = logging.StreamHandler(sys.stdout)
        handler.setFormatter(logging.Formatter(fmt))
        logging.basicConfig(level=log_level, handlers=[handler], force=True)


def normalize_ports(ports) -> list:
    return list(ports) if isinstance(ports, (list, tuple)) else [ports]

# UTILITIES
def format_bytes(n: int, human: bool = True) -> str:
    if not human or n < 1024:    return f"{n}B"
    if n < 1024**2:              return f"{n / 1024:.2f}KB"
    if n < 1024**3:              return f"{n / 1024**2:.2f}MB"
    return                              f"{n / 1024**3:.2f}GB"

def format_duration(s: float) -> str:
    h, rem = divmod(int(s), 3600)
    m, sec = divmod(rem, 60)
    return f"{h}h{m}m" if h else f"{m}m{sec}s" if m else f"{sec}s"

# HTTP/WEBSOCKET HANDSHAKE
class Handshake:
    """Parses an HTTP/WebSocket request and builds the appropriate response."""

    def __init__(self, data: bytes):
        self.method      = ''
        self.path        = '/'
        self.headers: Dict[str, str] = {}
        self.is_valid    = False
        self.is_websocket = False
        self._parse(data)

    def _parse(self, data: bytes):
        try:
            lines = data.decode('utf-8', errors='ignore').split('\n')
            if not lines or not lines[0].strip():
                return
            parts = lines[0].strip().split()
            self.method = parts[0].upper()
            if self.method.startswith('SSH-'):
                return
            self.path = parts[1] if len(parts) > 1 else '/'
            for line in lines[1:]:
                line = line.strip()
                if ':' in line:
                    k, v = line.split(':', 1)
                    key = k.strip().lower()
                    if key not in self.headers:
                        self.headers[key] = v.strip()
            self.is_websocket = (
                'websocket' in self.headers.get('upgrade',    '').lower() and
                'upgrade'   in self.headers.get('connection', '').lower()
            )
            self.is_valid = True
        except Exception:
            pass

    def build_response(self, mode: str, custom_text: str) -> Optional[bytes]:
        if not self.is_valid:
            return None
        logging.info(f"  {self.method} {self.path}{' [WS]' if self.is_websocket else ''}")

        if mode == 'auto':
            mode = '101' if self.is_websocket else '200'

        match mode:
            case '101':
                resp = f"HTTP/1.1 101 {custom_text or 'Switching Protocols'}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n".encode()
                if 'sec-websocket-key' in self.headers:
                    key    = self.headers['sec-websocket-key'] + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
                    accept = base64.b64encode(hashlib.sha1(key.encode()).digest()).decode()
                    resp  += f"Sec-WebSocket-Accept: {accept}\r\nSec-WebSocket-Version: 13\r\n".encode()
            case '100':
                return f"HTTP/1.1 100 {custom_text or 'Continue'}\r\n\r\n".encode()
            case _:
                resp = f"HTTP/1.1 200 {custom_text or 'OK'}\r\nConnection: Upgrade\r\n".encode()

        resp += f"Server: nginx/1.20.2\r\nDate: {time.strftime('%a, %d %b %Y %H:%M:%S GMT', time.gmtime())}\r\n\r\n".encode()
        return resp


# CONNECTION STATE
class Conn:
    """Per-connection state. One instance per client; no threads, no locks."""
    __slots__ = ('client', 'backend', 'addr', 'state', 'inbuf',
                 'to_client', 'to_backend', 'attempts', 'retry_at',
                 'connect_deadline', 'read_deadline', 'last_activity',
                 'start', 'sent', 'recvd')

    def __init__(self, client: socket.socket, addr: tuple):
        now = time.time()
        self.client           = client
        self.backend          = None
        self.addr             = addr
        self.state            = 'reading'   # reading -> connecting -> relay
        self.inbuf            = bytearray()
        self.to_client        = bytearray() # queued bytes for the client
        self.to_backend       = bytearray() # queued bytes for the backend
        self.attempts         = 0
        self.retry_at         = 0.0
        self.connect_deadline = 0.0
        self.read_deadline    = 0.0
        self.last_activity    = now
        self.start            = now
        self.sent             = 0
        self.recvd            = 0


# SERVER — one thread, one selector, all connections
class TunnelServer:

    def __init__(self, ports: list, config: Config):
        self.ports   = ports
        self.config  = config
        self.running = False
        self.sel     = selectors.DefaultSelector()
        self.listens: list = []
        self.conns: set = set()
        self.active = self.total = self.bytes_sent = self.bytes_recvd = 0
        self.start_time = time.time()

    def _listen(self, port: int):
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        s.bind((self.config.bind_address, port))
        s.listen(self.config.max_connections)
        s.setblocking(False)
        self.sel.register(s, selectors.EVENT_READ, ('accept', None))
        self.listens.append(s)
        logging.info(f"> HTTP server listening on {self.config.bind_address}:{port}")

    def serve(self):
        cfg = self.config
        for port in self.ports:
            self._listen(port)
        self.running = True
        next_stats = time.time() + cfg.stats_interval if cfg.stats_interval else 0

        try:
            while self.running:
                events = self.sel.select(timeout=1.0)
                for key, mask in events:
                    kind, conn = key.data
                    if kind == 'accept':
                        self._accept(key.fileobj)
                    elif kind == 'client':
                        if mask & selectors.EVENT_READ:
                            self._on_client_read(conn)
                        if conn in self.conns and mask & selectors.EVENT_WRITE:
                            self._flush(conn.client, conn.to_client, 'client', conn)
                    elif kind == 'backend':
                        if mask & selectors.EVENT_READ:
                            self._on_backend_read(conn)
                        if conn in self.conns and mask & selectors.EVENT_WRITE:
                            self._flush(conn.backend, conn.to_backend, 'backend', conn)
                    elif kind == 'connect':
                        self._on_backend_writable(conn)
                self._sweep()
                if next_stats and time.time() >= next_stats:
                    self._log_stats()
                    next_stats = time.time() + cfg.stats_interval
        finally:
            for conn in list(self.conns):
                self._close(conn)
            for s in self.listens:
                try:
                    self.sel.unregister(s)
                except Exception:
                    pass
                s.close()
            logging.info(f"Shutdown: {self.total} connections, "
                         f"↑{format_bytes(self.bytes_sent, cfg.show_bytes_human)} "
                         f"↓{format_bytes(self.bytes_recvd, cfg.show_bytes_human)}, "
                         f"Uptime: {format_duration(time.time() - self.start_time)}")

    # ── accept ──
    def _accept(self, listener: socket.socket):
        while True:
            try:
                client, addr = listener.accept()
            except BlockingIOError:
                return
            except OSError as e:
                logging.error(f"Accept error: {e}")
                return
            if self.active >= self.config.max_connections:
                logging.warning(f"Connection limit reached, rejecting {addr[0]}")
                client.close()
                continue
            logging.info(f"New connection: {addr[0]}:{addr[1]}")
            client.setblocking(False)
            if self.config.enable_nodelay:
                client.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
            conn = Conn(client, addr)
            conn.read_deadline = time.time() + self.config.timeout_initial
            if self.config.handle_split:
                conn.read_deadline += self.config.timeout_split
            self.conns.add(conn)
            self.active += 1
            self.total  += 1
            self.sel.register(client, selectors.EVENT_READ, ('client', conn))

    # ── request reading ──
    def _on_client_read(self, conn: Conn):
        if conn.state == 'relay':
            # relay data from client
            self._pump(conn.client, conn.to_backend, conn, from_client=True)
            return
        if conn.state != 'reading':
            return  # connecting: backend not ready, wait for sweep/WRITE
        try:
            chunk = conn.client.recv(self.config.buffer_size)
        except (ConnectionResetError, BrokenPipeError, OSError):
            if self.config.ignore_early_reset:
                logging.debug(f"Early disconnect: {conn.addr[0]}")
            self._close(conn)
            return
        if not chunk:
            self._close(conn)
            return
        conn.inbuf += chunk
        conn.last_activity = time.time()
        if self.config.handle_split and b'websocket' not in bytes(conn.inbuf).lower():
            return  # keep waiting for the split payload, up to read_deadline
        self._start_backend(conn)

    # ── backend connect (non-blocking, with retries) ──
    def _new_backend_sock(self) -> socket.socket:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.setblocking(False)
        if self.config.enable_nodelay:
            s.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        return s

    def _start_backend(self, conn: Conn):
        cfg = self.config
        conn.state = 'connecting'
        try:
            self.sel.unregister(conn.client)
        except Exception:
            pass
        self._dial(conn)

    def _dial(self, conn: Conn):
        cfg = self.config
        conn.attempts += 1
        s = self._new_backend_sock()
        err = s.connect_ex((cfg.backend_host, cfg.backend_port))
        if err not in (0, errno.EINPROGRESS, errno.EWOULDBLOCK):
            s.close()
            self._backend_failed(conn, f"dial error {err}")
            return
        conn.backend = s
        conn.connect_deadline = time.time() + cfg.timeout_conn
        if err == 0:
            self._backend_connected(conn)   # localhost fast path
        else:
            self.sel.register(s, selectors.EVENT_WRITE, ('connect', conn))

    def _on_backend_writable(self, conn: Conn):
        if conn not in self.conns or conn.backend is None:
            return
        err = conn.backend.getsockopt(socket.SOL_SOCKET, socket.SO_ERROR)
        if err != 0:
            try:
                self.sel.unregister(conn.backend)
            except Exception:
                pass
            conn.backend.close()
            conn.backend = None
            self._backend_failed(conn, f"connect error {err}")
            return
        self._backend_connected(conn)

    def _backend_failed(self, conn: Conn, why: str):
        cfg = self.config
        if conn.attempts < cfg.backend_retries:
            logging.warning(f"Backend refused, retry {conn.attempts}/{cfg.backend_retries}")
            conn.retry_at = time.time() + cfg.backend_delay
        else:
            logging.error(f"Backend unavailable after {cfg.backend_retries} attempts ({why})")
            self._close(conn)

    def _backend_connected(self, conn: Conn):
        cfg = self.config
        logging.debug(f"  Backend connected: {cfg.backend_host}:{cfg.backend_port}")
        try:
            self.sel.unregister(conn.backend)
        except Exception:
            pass
        response = Handshake(bytes(conn.inbuf)).build_response(cfg.response_mode, cfg.response_text)
        conn.inbuf = bytearray()
        if response:
            conn.to_client += response
        conn.state = 'relay'
        conn.last_activity = time.time()
        events = selectors.EVENT_READ
        if conn.to_client:
            events |= selectors.EVENT_WRITE
        self.sel.register(conn.client, events, ('client', conn))
        self.sel.register(conn.backend, selectors.EVENT_READ, ('backend', conn))

    # ── relay ──
    def _pump(self, sock: socket.socket, outbox: bytearray, conn: Conn, from_client: bool):
        try:
            chunk = sock.recv(self.config.buffer_size)
        except (ConnectionResetError, BrokenPipeError, OSError):
            self._close(conn)
            return
        if not chunk:
            self._close(conn)
            return
        outbox += chunk
        conn.last_activity = time.time()
        if from_client:
            conn.recvd += len(chunk)
            peer, role = conn.backend, 'backend'
        else:
            conn.sent += len(chunk)
            peer, role = conn.client, 'client'
        try:
            self.sel.modify(peer, selectors.EVENT_READ | selectors.EVENT_WRITE, (role, conn))
        except Exception:
            pass

    def _on_backend_read(self, conn: Conn):
        if conn.state == 'relay':
            self._pump(conn.backend, conn.to_client, conn, from_client=False)

    def _flush(self, sock: socket.socket, outbox: bytearray, role: str, conn: Conn):
        if not outbox:
            try:
                self.sel.modify(sock, selectors.EVENT_READ, (role, conn))
            except Exception:
                pass
            return
        try:
            sent = sock.send(outbox)
        except (BlockingIOError, InterruptedError):
            return
        except (ConnectionResetError, BrokenPipeError, OSError):
            self._close(conn)
            return
        del outbox[:sent]
        if not outbox:
            try:
                self.sel.modify(sock, selectors.EVENT_READ, (role, conn))
            except Exception:
                pass

    # ── sweeps: deadlines, retries, idle ──
    def _sweep(self):
        cfg = self.config
        now = time.time()
        for conn in list(self.conns):
            if conn.state == 'reading':
                if conn.inbuf and (not cfg.handle_split or now >= conn.read_deadline):
                    self._start_backend(conn)
                elif now >= conn.read_deadline:
                    logging.debug(f"Timeout: {conn.addr[0]}")
                    self._close(conn)
            elif conn.state == 'connecting':
                if conn.backend is None:
                    if conn.retry_at and now >= conn.retry_at:
                        conn.retry_at = 0.0
                        self._dial(conn)
                elif now >= conn.connect_deadline:
                    try:
                        self.sel.unregister(conn.backend)
                    except Exception:
                        pass
                    conn.backend.close()
                    conn.backend = None
                    self._backend_failed(conn, "connect timeout")
            elif now - conn.last_activity > cfg.timeout_idle:
                logging.debug(f"Idle timeout ({cfg.timeout_idle}s)")
                self._close(conn)

    def _log_stats(self):
        cfg = self.config
        logging.info(f"[Stats] Active={self.active}, Total={self.total}, "
                     f"↑{format_bytes(self.bytes_sent, cfg.show_bytes_human)} "
                     f"↓{format_bytes(self.bytes_recvd, cfg.show_bytes_human)}, "
                     f"Uptime={format_duration(time.time() - self.start_time)}")

    def _close(self, conn: Conn):
        if conn not in self.conns:
            return
        self.conns.discard(conn)
        self.active -= 1
        self.bytes_sent  += conn.sent
        self.bytes_recvd += conn.recvd
        cfg = self.config
        if cfg.log_connections:
            logging.info(f"Closed: {conn.addr[0]} "
                         f"(↓{format_bytes(conn.sent,  cfg.show_bytes_human)} "
                         f"↑{format_bytes(conn.recvd, cfg.show_bytes_human)}, "
                         f"{format_duration(time.time() - conn.start)})")
        for sock in (conn.client, conn.backend):
            if sock is not None:
                try:
                    self.sel.unregister(sock)
                except Exception:
                    pass
                try:
                    sock.close()
                except Exception:
                    pass


# MAIN
def main():
    parser = argparse.ArgumentParser(description='WebSocket Tunnel Server')
    parser.add_argument('-c', '--config', default='config.yaml', help='Config file (default: config.yaml)')
    parser.add_argument('--debug', action='store_true', help='Enable debug logging')
    args = parser.parse_args()

    config = Config(args.config)
    if args.debug:
        config.data['logging']['level'] = 'DEBUG'
    config.setup_logging()

    print(BANNER)
    print()

    http_ports = normalize_ports(config.get('ports', 'http'))

    logging.info("=" * 60)
    logging.info(f"Backend: {config.backend_host}:{config.backend_port}")
    logging.info(f"HTTP Ports: {', '.join(map(str, http_ports))}")
    if config.response_text:
        logging.info(f"Custom Response: '{config.response_text}'")
    if config.stats_interval and config.stats_interval > 0:
        logging.info(f"Stats Interval: {config.stats_interval}s")
    logging.info("=" * 60)

    # No in-process restart loop: systemd (Restart=always) owns restarts.
    server = TunnelServer(http_ports, config=config)

    def signal_handler(sig, frame):
        print("\nShutting down...")
        server.running = False

    signal.signal(signal.SIGINT,  signal_handler)
    signal.signal(signal.SIGTERM, signal_handler)

    try:
        server.serve()
    except KeyboardInterrupt:
        pass

if __name__ == '__main__':
    main()
