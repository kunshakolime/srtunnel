server {
    listen 8444 ssl;
    server_name ${DOMAIN};
    root /var/www/srtdash;
    index index.html;
    ssl_certificate /root/srtunnel/server.crt;
    ssl_certificate_key /root/srtunnel/server.key;
    location /api/ {
        proxy_pass http://127.0.0.1:51700/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location / {
        try_files $uri $uri/ =404;
    }
}

server {
    listen 8444 ssl default_server;
    server_name _;
    ssl_certificate /root/srtunnel/server.crt;
    ssl_certificate_key /root/srtunnel/server.key;
    return 444;
}